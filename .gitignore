# AI DAM (WI-31): provisioned model weights and derived caches — never commit
.AImodels/
# Stray runtime-named dirs at repo root shadow imports as namespace packages
/open_clip/
/torch/
/transformers/
/timm/
/mobile_sam/
.ai_cache/
*.gguf
*.onnx
*.npz
.sqlite_cache/
.thumbnails_cache/
.omniquery/
.coverage
# Benchmark scratch stays out, but the evidence reports that shipped
# constants are derived from must be committed and reviewable.
benchmarks/results/*
!benchmarks/results/grounding_calibration.json
!benchmarks/results/wi31_benchmark.json
!benchmarks/results/faiss_graph_evidence.json
!benchmarks/results/faiss_graph_evidence_synthetic.json
!benchmarks/results/faiss_graph_evidence_images.json
!benchmarks/results/face_detection_recall_native.json
!benchmarks/results/face_detection_recall_ms1600.json
# Vendored Windows GPU faiss build ships its extension module
!vendor/faiss-gpu-win64/faiss/*.pyd
!benchmarks/results/face_embedder_ab.json
# The browser report's screenshots and page are machine-local and
# regenerable (`just bench browser-report`); its manifest -- the run's
# facts and provenance stamp -- is the reviewable part.
!benchmarks/results/browser/
benchmarks/results/browser/*
!benchmarks/results/browser/manifest.json

# Personal launch scripts. The README has every user make these by copying
# the sample_run_* files and filling in their own paths, passwords and
# ports, and tells them to carry the same file across upgrades. One of ours
# in the repo would overwrite theirs on update, so these stay local.
run_smartgallery.bat
run_exhibition.bat
run_smartgallery.sh
run_exhibition.sh

# built database: reproducible via `python -m db.build`
db/*.db
db/*.db-wal
db/*.db-shm
db/*.backup

# npm: biome lives in node_modules; package-lock.json is committed. The
# contract generator has its own tree (frontend/codegen) because it needs a
# TypeScript the application does not; `node_modules/` matches at any depth.
node_modules/
# esbuild's output. Generated from frontend/src by `just web build`, which
# every recipe that serves or tests the app depends on. The Python `build/`
# rule above already covers this path by accident; say it on purpose here, so
# tidying that rule cannot start committing bundles.
sg_web/static/build/
