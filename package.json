{
  "private": true,
  "type": "module",
  "//": "22.18 is where node runs a .ts file by default and without an experimental warning (node doc/api/typescript.md); the build script depends on that, and nothing here is ever shipped to a browser as-is.",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "lint": "biome lint . --error-on-warnings",
    "format-check": "biome format .",
    "format": "biome format . --write",
    "check": "biome ci . --error-on-warnings",
    "fix": "biome check . --write",
    "types-source": "tsc -p frontend",
    "types-build": "tsc -p frontend/tsconfig.node.json",
    "build-web": "node frontend/build.ts",
    "watch-web": "node frontend/build.ts --watch",
    "api-types": "npm --silent --prefix frontend/codegen run generate",
    "api-types-check": "npm --silent --prefix frontend/codegen run check"
  },
  "dependencies": {
    "openapi-fetch": "0.17.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.9",
    "@types/node": "24.10.1",
    "esbuild": "0.28.2",
    "typescript": "7.0.2"
  }
}
